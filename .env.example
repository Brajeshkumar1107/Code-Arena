# CodeArena Runner - Environment Variables
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# Generate secrets with:
#   RUNNER_TOKEN=$(openssl rand -hex 32)
#   DB_PASSWORD=$(openssl rand -hex 16)

# Secret token that internal services must present to execute code.
RUNNER_TOKEN=

# MySQL root password.
DB_PASSWORD=codearena_root
